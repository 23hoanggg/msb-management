generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS (Các trạng thái) ---
enum Role {
  ADMIN
  STAFF
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  REPAIRING
}

enum OrderStatus {
  PENDING
  SERVED
  CANCELLED
}

// --- TABLES (Các thực thể) ---

model User {
  id             String        @id @default(uuid())
  username       String        @unique
  email          String        @unique
  password       String
  fullName       String
  role           Role          @default(STAFF)
  createdAt      DateTime      @default(now())
  sessionsOpened RoomSession[] @relation("CheckInStaff")
  sessionsClosed RoomSession[] @relation("CheckOutStaff")
}

model RoomType {
  id          String  @id @default(uuid())
  name        String // Solo, Couple, VIP...
  basePrice   Float // Giá gốc 1 giờ
  description String?
  rooms       Room[]
}

model Room {
  id       String        @id
  name     String
  status   RoomStatus    @default(AVAILABLE)
  roomType RoomType      @relation(fields: [typeId], references: [id])
  typeId   String
  sessions RoomSession[]
}

model Discount {
  id          String        @id @default(uuid())
  code        String        @unique
  description String?
  percent     Float
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean       @default(true)
  sessions    RoomSession[]
}

model RoomSession {
  id        String    @id @default(uuid())
  room      Room      @relation(fields: [roomId], references: [id])
  roomId    String
  startTime DateTime  @default(now())
  endTime   DateTime?

  // Các cột phục vụ tính tiền và thống kê
  totalRoomFee    Float @default(0) // Tiền giờ
  totalServiceFee Float @default(0) // Tiền menu
  totalAmount     Float @default(0) // Tổng tiền gốc (Tiền giờ + Tiền menu)
  discountAmount  Float @default(0) // Số tiền được giảm
  finalAmount     Float @default(0) // Khách thực trả (totalAmount - discountAmount)
  subTotal        Int?  @default(0) // Tổng tiền ban đầu

  isPaid Boolean @default(false)

  // 🟢 ĐÃ SỬA: Thay thế staffId cũ bằng 2 cột này
  checkInStaffId String?
  checkInStaff   User?   @relation("CheckInStaff", fields: [checkInStaffId], references: [id])

  checkOutStaffId String?
  checkOutStaff   User?   @relation("CheckOutStaff", fields: [checkOutStaffId], references: [id])

  discount   Discount? @relation(fields: [discountId], references: [id])
  discountId String?

  orderItems OrderItem[]
}

model Category {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}

model Product {
  id            String      @id @default(uuid())
  name          String
  price         Float
  stockQuantity Int         @default(0)
  imageUrl      String?
  category      Category    @relation(fields: [categoryId], references: [id])
  categoryId    String
  orderItems    OrderItem[]
}

model OrderItem {
  id          Int         @id @default(autoincrement())
  session     RoomSession @relation(fields: [sessionId], references: [id])
  sessionId   String
  product     Product     @relation(fields: [productId], references: [id])
  productId   String
  quantity    Int
  priceAtTime Float
  status      OrderStatus @default(PENDING)
  orderTime   DateTime    @default(now())
}
